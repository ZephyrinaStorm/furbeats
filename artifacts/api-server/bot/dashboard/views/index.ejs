<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HowlBeats — Music with a Soul</title>
  <meta name="description" content="HowlBeats is a furry-themed Discord music bot with multi-platform support, audio filters, a live web dashboard, and 55+ slash commands.">
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="<%= botClient.user ? botClient.user.displayAvatarURL({ size: 64 }) : '/furry-avatar.jpg' %>">
</head>
<body>
<%- include('header', { currentPage: 'home' }) %>

<% const errorMsg = locals.query && locals.query.error; %>
<% if (errorMsg) { %><div class="notice-bar error">⚠️ <%= decodeURIComponent(errorMsg) %></div><% } %>

<!-- STARS LAYER -->
<div class="stars" aria-hidden="true"></div>
<div class="stars2" aria-hidden="true"></div>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-inner">
    <img
      src="<%= botClient.user ? botClient.user.displayAvatarURL({ size: 256 }) : '/furry-avatar.jpg' %>"
      class="hero-avatar"
      alt="HowlBeats"
      onerror="this.src='/furry-avatar.jpg'"
    >
    <h1 class="hero-title">Music with a Soul.</h1>
    <p class="hero-sub">A cozy corner of the internet for the furry fandom to share music together.<br>Playful, expressive, and unmistakably yours. Powered by Lavalink v4 for crystal clear audio.</p>
    <div class="hero-btns">
      <a href="https://discord.com/api/oauth2/authorize?client_id=<%= botClient.user ? botClient.user.id : '' %>&permissions=8&scope=bot%20applications.commands"
        target="_blank" class="btn btn-primary btn-lg btn-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.1 18.08.114 18.1.133 18.114a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
        Invite HowlBeats
      </a>
      <a href="/#features" class="btn btn-outline btn-lg btn-pill">Explore Features</a>
    </div>
  </div>
</section>

<!-- PLATFORMS STRIP -->
<div class="platforms-strip">
  <p class="platforms-strip-label">PLAY FROM YOUR FAVORITE SOURCES</p>
  <div class="platforms-strip-icons">
    <img src="https://cdn.simpleicons.org/youtube/ffffff" alt="YouTube" title="YouTube">
    <img src="https://cdn.simpleicons.org/spotify/ffffff" alt="Spotify" title="Spotify">
    <img src="https://cdn.simpleicons.org/soundcloud/ffffff" alt="SoundCloud" title="SoundCloud">
    <img src="https://cdn.simpleicons.org/applemusic/ffffff" alt="Apple Music" title="Apple Music">
    <img src="https://cdn.simpleicons.org/bandcamp/ffffff" alt="Bandcamp" title="Bandcamp">
    <img src="https://cdn.simpleicons.org/vimeo/ffffff" alt="Vimeo" title="Vimeo">
    <img src="https://cdn.simpleicons.org/tidal/ffffff" alt="Tidal" title="Tidal">
    <img src="https://cdn.simpleicons.org/twitch/ffffff" alt="Twitch" title="Twitch">
  </div>
</div>

<!-- DESIGNED FOR THE FANDOM -->
<section class="fandom-section" id="features">
  <div class="fandom-inner">
    <h2 class="fandom-title">Designed for the Fandom</h2>
    <p class="fandom-sub">More than just playback. HowlBeats brings high-fidelity audio and powerful queue management wrapped in a warm, welcoming aesthetic.</p>
    <div class="fandom-cards">
      <div class="fandom-card">
        <div class="fandom-card-icon icon-blue">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h3>Lavalink Powered</h3>
        <p>Crystal-clear, high-quality audio with zero lag. No stuttering, no interrupted vibes for your listening sessions.</p>
      </div>
      <div class="fandom-card">
        <div class="fandom-card-icon icon-purple">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        </div>
        <h3>Advanced Queues</h3>
        <p>Full control over your music. Shuffle, loop, move tracks, or clear the queue. Everyone gets a turn to share their favorites.</p>
      </div>
      <div class="fandom-card">
        <div class="fandom-card-icon icon-pink">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z"/><path d="M19 3v18"/></svg>
        </div>
        <h3>Audio Filters</h3>
        <p>Feeling the energy? Turn up the bass or let the music physically move you. Perfect for late night DJ sessions.</p>
      </div>
      <div class="fandom-card">
        <div class="fandom-card-icon icon-teal">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        </div>
        <h3>Multi-Platform</h3>
        <p>Stream from 11+ platforms — YouTube, Spotify, Apple Music, Tidal, SoundCloud, Bandcamp, Vimeo and more.</p>
      </div>
      <div class="fandom-card">
        <div class="fandom-card-icon icon-green">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        </div>
        <h3>Web Dashboard</h3>
        <p>Manage settings, watch the queue update live every 3 seconds, and control playback from any browser.</p>
      </div>
      <div class="fandom-card">
        <div class="fandom-card-icon icon-orange">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <h3>DJ System</h3>
        <p>Assign DJ roles so only trusted members control playback. Restrict specific commands to keep your queue safe.</p>
      </div>
    </div>
  </div>
</section>

<!-- COMMANDS SHOWCASE -->
<section class="commands-showcase">
  <div class="commands-showcase-inner">
    <div class="commands-showcase-left">
      <p class="showcase-eyebrow">SLASH COMMANDS</p>
      <h2 class="showcase-title">Everything at your fingertips</h2>
      <p class="showcase-sub">55 slash commands make controlling the music effortless. From simple playback to audio tweaks, HowlBeats responds instantly.</p>
      <div class="showcase-cmds">
        <div class="showcase-cmd"><span class="showcase-cmd-name">/play</span><span class="showcase-cmd-desc">Search or paste a link</span></div>
        <div class="showcase-cmd"><span class="showcase-cmd-name">/skip</span><span class="showcase-cmd-desc">Next track</span></div>
        <div class="showcase-cmd"><span class="showcase-cmd-name">/bassboost</span><span class="showcase-cmd-desc">Turn it up</span></div>
        <div class="showcase-cmd"><span class="showcase-cmd-name">/shuffle</span><span class="showcase-cmd-desc">Mix it up</span></div>
        <div class="showcase-cmd"><span class="showcase-cmd-name">/queue</span><span class="showcase-cmd-desc">See upcoming tracks</span></div>
        <div class="showcase-cmd"><span class="showcase-cmd-name">/autoplay</span><span class="showcase-cmd-desc">Never stop the music</span></div>
      </div>
      <a href="/commands" class="btn btn-primary btn-pill" style="margin-top:2rem;display:inline-flex;">View All 55 Commands</a>
    </div>
    <div class="commands-showcase-right">
      <!-- Discord embed mockup -->
      <div class="discord-mockup">
        <div class="discord-mockup-header">
          <img src="<%= botClient.user ? botClient.user.displayAvatarURL({ size: 64 }) : '/furry-avatar.jpg' %>" class="discord-bot-avatar" alt="Bot" onerror="this.src='/furry-avatar.jpg'">
          <div>
            <span class="discord-bot-name">HowlBeats</span>
            <span class="discord-bot-badge">BOT</span>
          </div>
        </div>
        <p class="discord-bot-status">Playing music...</p>
        <div class="discord-embed">
          <div class="discord-embed-bar"></div>
          <div class="discord-embed-body">
            <div class="discord-embed-icon">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div>
              <p class="discord-embed-label">Now Playing</p>
              <p class="discord-embed-title">Midnight Starfield Lullaby</p>
              <p class="discord-embed-req">Requested by @fluffypaws</p>
            </div>
          </div>
        </div>
        <div class="discord-controls">
          <button class="dc-btn">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6 3h2v18H6zM18 3v18l-12-9z" transform="scale(-1,1) translate(-24,0)"/></svg>
          </button>
          <button class="dc-btn">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </button>
          <button class="dc-btn dc-btn-active">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          </button>
          <button class="dc-btn">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 005 5l1.5-2.5 5 2v3a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
          </button>
          <button class="dc-btn">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M5 4l12 8-12 8V4z"/><path d="M17 4v16"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STATS BAR -->
<div class="stats-bar">
  <div class="stat-item">
    <div class="stat-num"><%= botClient.guilds.cache.size.toLocaleString() %></div>
    <div class="stat-label">Servers</div>
  </div>
  <div class="stat-item">
    <div class="stat-num"><%= botClient.guilds.cache.reduce((a,g) => a + g.memberCount, 0).toLocaleString() %></div>
    <div class="stat-label">Users</div>
  </div>
  <div class="stat-item">
    <div class="stat-num"><%= commands.length %></div>
    <div class="stat-label">Commands</div>
  </div>
  <div class="stat-item">
    <div class="stat-num"><%= botClient.kazagumo ? botClient.kazagumo.players.size : 0 %></div>
    <div class="stat-label">Active Players</div>
  </div>
  <div class="stat-item">
    <div class="stat-num"><%= Math.round(botClient.ws.ping) %>ms</div>
    <div class="stat-label">Ping</div>
  </div>
</div>

<!-- CTA -->
<section class="cta-band">
  <h2>Ready to vibe?</h2>
  <p>Add HowlBeats to your server and start the music — free, forever.</p>
  <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
    <a href="https://discord.com/api/oauth2/authorize?client_id=<%= botClient.user ? botClient.user.id : '' %>&permissions=8&scope=bot%20applications.commands"
      target="_blank" class="btn btn-primary btn-lg btn-pill">Invite HowlBeats</a>
    <a href="/commands" class="btn btn-outline btn-lg btn-pill">Browse Commands</a>
  </div>
</section>

<footer>
  <strong>HowlBeats</strong> — The Furry Music Bot &bull;
  <a href="/commands">Commands</a> &bull;
  <a href="/about">About</a> &bull;
  <a href="/dashboard">Dashboard</a> &bull;
  <a href="/terms">Terms of Service</a> &bull;
  <a href="/privacy">Privacy Policy</a><br>
  <small>Powered by Lavalink v4 &bull; Multi-platform music &bull; Built with love for the furry community &bull; <%= commands.length %> commands available</small>
</footer>
</body>
</html>
